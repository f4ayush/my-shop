// Pharmacy database schema.
// Money is stored as integer paise (₹1 = 100 paise) to avoid float rounding.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  CUSTOMER
  PHARMACIST
  ADMIN
}

/// Drug schedule under the Drugs & Cosmetics Rules.
/// X (and NDPS) items must never be sold online — the app must block them.
enum DrugSchedule {
  OTC
  H
  H1
  X
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  /// Online payment not completed yet; stock is held for a short time.
  PAYMENT_PENDING
  PLACED
  AWAITING_RX_REVIEW
  RX_REJECTED
  CONFIRMED
  PACKED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfilmentMode {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  COD
  /// Paid online by another method (wallet, EMI…) or method not known yet.
  ONLINE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum DeliveryStatus {
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

// ─── Users ───────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  phone        String   @unique // E.164, e.g. +919876543210 — customers sign in by OTP
  name         String?
  email        String?  @unique
  role         Role     @default(CUSTOMER)
  /// Staff only (pharmacist/admin). Customers use phone OTP and have no password.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses             Address[]
  prescriptions         Prescription[] @relation("PrescriptionOwner")
  reviewedPrescriptions Prescription[] @relation("PrescriptionReviewer")
  orders                Order[]
  auditLogs             AuditLog[]
  sessions              Session[]
  cart                  Cart?
}

/// One-time login code. Only an HMAC of the code is stored.
model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// Login session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Guest carts are found by a random cookie token; on login they merge into the user's cart.
model Cart {
  id        String     @id @default(cuid())
  tokenHash String?    @unique
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String? // "Home", "Office"
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ─── Catalogue & inventory ───────────────────────────────

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id           String       @id @default(cuid())
  /// Item code from the billing software — key for inventory sync.
  sku          String       @unique
  name         String
  slug         String       @unique
  /// Salt / active ingredients, e.g. "Amoxicillin 500 mg". Used for salt search.
  composition  String?
  manufacturer String?
  packSize     String? // "Strip of 10 tablets"
  description  String?
  mrpPaise     Int
  pricePaise   Int
  hsnCode      String?
  gstRate      Decimal      @db.Decimal(5, 2) // percent, e.g. 5.00
  schedule     DrugSchedule @default(OTC)
  requiresRx   Boolean      @default(false)
  isActive     Boolean      @default(true)
  imageUrls    String[]
  categoryId   String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  batches    InventoryBatch[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([name])
  @@index([composition])
  @@index([categoryId])
}

model InventoryBatch {
  id         String   @id @default(cuid())
  productId  String
  batchNo    String
  expiryDate DateTime @db.Date
  quantity   Int
  /// Units held for placed-but-unfulfilled orders.
  reserved   Int      @default(0)
  syncedAt   DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, batchNo])
  @@index([expiryDate])
}

// ─── Prescriptions ───────────────────────────────────────

model Prescription {
  id           String             @id @default(cuid())
  userId       String
  /// Key in the PRIVATE object-storage bucket. Serve only via short-lived signed URLs.
  fileKey      String
  mimeType     String
  sizeBytes    Int
  /// When the customer consented to us storing and processing this health data (DPDP Act).
  consentAt    DateTime
  status       PrescriptionStatus @default(PENDING)
  doctorName   String?
  issuedOn     DateTime?          @db.Date
  expiresAt    DateTime?          @db.Date
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime           @default(now())

  user       User    @relation("PrescriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("PrescriptionReviewer", fields: [reviewedById], references: [id])
  orders     Order[]

  @@index([userId])
  @@index([status])
}

// ─── Orders, payments, fulfilment ────────────────────────

model Order {
  id               String         @id @default(cuid())
  orderNumber      String         @unique // human-friendly, e.g. MP-2026-000123
  userId           String
  status           OrderStatus    @default(PLACED)
  fulfilmentMode   FulfilmentMode
  addressId        String?
  prescriptionId   String?
  pickupSlotStart  DateTime?
  subtotalPaise    Int
  gstPaise         Int
  deliveryFeePaise Int            @default(0)
  totalPaise       Int
  notes            String?
  /// Pharmacist's note on the prescription check, shown to the customer (e.g. why it was rejected).
  rxReviewNotes    String?
  /// Why staff cancelled the order (shown to the customer).
  cancelReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  address      Address?      @relation(fields: [addressId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  delivery     Delivery?
  invoice      Invoice?
  notifications Notification[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  batchId        String?
  /// Snapshots so invoices stay correct if the product changes later.
  productName    String
  hsnCode        String?
  quantity       Int
  unitPricePaise Int
  gstRate        Decimal @db.Decimal(5, 2)
  lineTotalPaise Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  batch   InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([orderId])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amountPaise      Int
  gateway          String? // "razorpay"; null for COD
  gatewayOrderId   String?
  gatewayPaymentId String?       @unique
  gatewayRefundId  String?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Delivery {
  id          String         @id @default(cuid())
  orderId     String         @unique
  status      DeliveryStatus @default(SCHEDULED)
  slotStart   DateTime?
  slotEnd     DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// GST tax invoice. Numbers are consecutive within each financial year (Apr–Mar), e.g. MP/26-27/000001.
model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  number        String   @unique
  financialYear String // "26-27"
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model InvoiceCounter {
  financialYear String @id
  lastNumber    Int    @default(0)
}

/// Payment-gateway webhook deliveries already processed (gateways retry, so handling must be idempotent).
model WebhookEvent {
  id         String   @id // gateway's event id
  provider   String
  receivedAt DateTime @default(now())
}

/// Customer messages sent about an order. One per (order, template), so retries never double-send.
/// Message text isn't stored; templates mention only the order number and status, never medicines.
model Notification {
  id        String   @id @default(cuid())
  orderId   String
  template  String // e.g. "order.ready_for_pickup"
  channel   String // "sms"
  status    String // "sent" | "failed"
  error     String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, template])
}

/// A stock file uploaded from the billing software: validated into a preview first, then applied.
model InventoryImport {
  id           String    @id @default(cuid())
  createdById  String
  fileName     String
  /// PREVIEW → APPLYING → APPLIED, or DISCARDED.
  status       String    @default("PREVIEW")
  /// Batches missing from the file are set to zero stock (the file is the full stock list).
  fullSnapshot Boolean   @default(false)
  /// Counts and issues shown in the preview and history.
  summary      Json
  /// Validated rows waiting to be applied.
  rows         Json
  createdAt    DateTime  @default(now())
  appliedAt    DateTime?

  @@index([createdAt])
}

/// Pincodes we deliver to, with per-pincode delivery fee.
model ServiceArea {
  id               String  @id @default(cuid())
  pincode          String  @unique
  area             String?
  deliveryFeePaise Int     @default(0)
  isActive         Boolean @default(true)
}

// ─── Audit ───────────────────────────────────────────────

/// Who viewed or changed prescriptions/orders (DPDP accountability).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // "prescription.view", "prescription.approve", "order.status_change"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}
