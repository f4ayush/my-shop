# Local development only. Copy to .env — never commit real credentials.
# Values must match docker-compose.yml.
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=pharmacy_dev_only
POSTGRES_DB=pharmacy
DATABASE_URL="postgresql://pharmacy:pharmacy_dev_only@localhost:5432/pharmacy?schema=public"

# Secret key for hashing login OTPs. Generate a long random value per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=

# SMS provider for OTPs. Leave empty in development: codes are printed to the dev server log.
# Production refuses to send OTPs until a provider is configured.
SMS_PROVIDER=

# Razorpay (online payments). Use TEST-mode keys in development: Dashboard > Settings > API Keys.
# Online payment is hidden at checkout until both keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A random secret you choose; enter the same value in Dashboard > Webhooks
# (URL: https://<your-domain>/api/webhooks/razorpay — events: payment.*, order.paid, refund.*).
RAZORPAY_WEBHOOK_SECRET=

# Business details printed on GST invoices and in the site footer.
STORE_LEGAL_NAME=
STORE_ADDRESS=
STORE_STATE=
STORE_GSTIN=
STORE_DRUG_LICENCE=
STORE_PHARMACIST=
# Customer care and grievance officer (shown on legal pages and in the footer).
STORE_EMAIL=
STORE_PHONE=
STORE_GRIEVANCE_OFFICER=
STORE_GRIEVANCE_EMAIL=
# Set to true only after a lawyer has reviewed /privacy, /terms, /returns, /shipping and /grievance.
STORE_LEGAL_REVIEWED=
