# Local development only. Copy to .env — never commit real credentials.
# Values must match docker-compose.yml.
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=pharmacy_dev_only
POSTGRES_DB=pharmacy
DATABASE_URL="postgresql://pharmacy:pharmacy_dev_only@localhost:5432/pharmacy?schema=public"

# Secret key for hashing login OTPs. Generate a long random value per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=

# Key for encrypting staff authenticator (TOTP) secrets and hashing recovery codes: 32 random bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it in your secrets manager. Changing or losing it disables every staff second factor
# (reset each with `npm run staff:reset-mfa -- <mobile>`).
MFA_ENCRYPTION_KEY=

# How many reverse proxies/CDNs sit in front of the app and append to X-Forwarded-For (for per-IP
# rate limits on login). 1 for a single load balancer; 0 if nothing does (then X-Real-IP is used).
TRUSTED_PROXY_COUNT=1

# ─── SMS (OTP and order updates) ─────────────────────────
# Leave empty in development: messages are printed to the dev server log.
# Production refuses to send until set. Supported: msg91
SMS_PROVIDER=
MSG91_AUTH_KEY=
# MSG91 template IDs, one per DLT-registered template (MSG91 > SMS > Templates, after adding each
# template with its DLT Template ID). Wording must match src/lib/sms/templates.ts and src/lib/notify.ts.
# Variables: the OTP template uses ##otp##; order templates use ##order##.
SMS_TEMPLATE_OTP=
SMS_TEMPLATE_ORDER_PLACED=
SMS_TEMPLATE_ORDER_RX_REVIEW=
SMS_TEMPLATE_ORDER_CONFIRMED=
SMS_TEMPLATE_ORDER_READY_FOR_PICKUP=
SMS_TEMPLATE_ORDER_OUT_FOR_DELIVERY=
SMS_TEMPLATE_ORDER_COMPLETED=
SMS_TEMPLATE_ORDER_RX_REJECTED=
SMS_TEMPLATE_ORDER_CANCELLED=

# ─── Private file storage (prescriptions) ────────────────
# local = ./storage on disk, development only. Production needs s3 (AWS S3 or Cloudflare R2).
STORAGE_DRIVER=local
# The bucket must be private: Block Public Access on, no public ACLs or presigned URLs.
S3_BUCKET=
# AWS: ap-south-1 (Mumbai). R2: auto.
S3_REGION=ap-south-1
# R2 only: https://<account-id>.r2.cloudflarestorage.com (leave empty for AWS S3).
S3_ENDPOINT=
# On AWS leave both empty and use an IAM role. Otherwise a key limited to this bucket
# (s3:GetObject, s3:PutObject, s3:DeleteObject only).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Server-side encryption: AES256 (SSE-S3, default), aws:kms (with optional S3_KMS_KEY_ID), or
# provider-default (R2 only — R2 encrypts every object at rest itself).
S3_SSE=AES256
S3_KMS_KEY_ID=

# Razorpay (online payments). Use TEST-mode keys in development: Dashboard > Settings > API Keys.
# Online payment is hidden at checkout until both keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A random secret you choose; enter the same value in Dashboard > Webhooks
# (URL: https://<your-domain>/api/webhooks/razorpay — events: payment.*, order.paid, refund.*).
RAZORPAY_WEBHOOK_SECRET=

# Business details printed on GST invoices and in the site footer.
STORE_LEGAL_NAME=
STORE_ADDRESS=
STORE_STATE=
STORE_GSTIN=
STORE_DRUG_LICENCE=
STORE_PHARMACIST=
# Customer care and grievance officer (shown on legal pages and in the footer).
STORE_EMAIL=
STORE_PHONE=
STORE_GRIEVANCE_OFFICER=
STORE_GRIEVANCE_EMAIL=
# Set to true only after a lawyer has reviewed /privacy, /terms, /returns, /shipping and /grievance.
STORE_LEGAL_REVIEWED=
